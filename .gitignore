# ==========================================
# Synapto Framework Gitignore
# ==========================================

# C++ Build Artifacts
build/
bin/
*.o
*.a
*.so
*.dylib
*.out
*.exe
compile_commands.json
.cache/

# CMake FetchContent sub-builds
_deps/

# Python & AI Artifacts
__pycache__/
*.py[cod]
*$py.class
*.pt
*.pth
*.onnx
models/*.onnx
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
ENV/

# MuJoCo / Visualization
*.log
*.mcap

# IDEs & System
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Docker
.docker_history
